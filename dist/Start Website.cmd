@echo off
cd /d "%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference = 'Stop'; $root = [IO.Path]::GetFullPath((Get-Location).Path); $listener = $null; foreach ($candidate in 8765..8775) { try { $listener = [Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback, $candidate); $listener.Start(); $port = $candidate; break } catch { $listener = $null } }; if (-not $listener) { throw 'No available local port. Close another preview and try again.' }; $url = 'http://127.0.0.1:' + $port + '/'; Write-Host ('Sindy website: ' + $url); Write-Host 'Keep this window open while browsing. Close it to stop the server.'; Start-Process $url; $mime = @{ '.html'='text/html; charset=utf-8'; '.css'='text/css'; '.js'='application/javascript'; '.json'='application/json'; '.png'='image/png'; '.jpg'='image/jpeg'; '.jpeg'='image/jpeg'; '.webp'='image/webp'; '.svg'='image/svg+xml'; '.gif'='image/gif'; '.ico'='image/x-icon'; '.woff2'='font/woff2'; '.ttf'='font/ttf'; '.pdf'='application/pdf' }; try { while ($true) { $client=$listener.AcceptTcpClient(); try { $client.ReceiveTimeout=5000; $stream=$client.GetStream(); $reader=[IO.StreamReader]::new($stream); $line=$reader.ReadLine(); if (-not $line) { continue }; while ($reader.ReadLine()) {}; $parts=$line.Split(' '); $method=$parts[0]; $relative=[Uri]::UnescapeDataString(($parts[1].Split('?')[0])).TrimStart('/'); $path=[IO.Path]::GetFullPath((Join-Path $root $relative)); $status='200 OK'; $type='text/plain; charset=utf-8'; if (($path -ne $root) -and (-not $path.StartsWith($root+[IO.Path]::DirectorySeparatorChar,[StringComparison]::OrdinalIgnoreCase))) { $status='403 Forbidden'; $bytes=[Text.Encoding]::UTF8.GetBytes('Forbidden') } elseif ($method -notin @('GET','HEAD')) { $status='405 Method Not Allowed'; $bytes=[Text.Encoding]::UTF8.GetBytes('GET and HEAD only') } else { if ([IO.Directory]::Exists($path)) { $path=Join-Path $path 'index.html' }; if ([IO.File]::Exists($path)) { $bytes=[IO.File]::ReadAllBytes($path); $ext=[IO.Path]::GetExtension($path).ToLower(); if ($mime.ContainsKey($ext)) {$type=$mime[$ext]} else {$type='application/octet-stream'} } else { $status='404 Not Found'; $bytes=[Text.Encoding]::UTF8.GetBytes('Not found') } }; $head=[Text.Encoding]::ASCII.GetBytes(('HTTP/1.1 '+$status+\"`r`nContent-Type: \"+$type+\"`r`nContent-Length: \"+$bytes.Length+\"`r`nCache-Control: no-store`r`nConnection: close`r`n`r`n\")); $stream.Write($head,0,$head.Length); if ($method -ne 'HEAD') { $stream.Write($bytes,0,$bytes.Length) } } catch { Write-Host 'A browser connection ended; server remains available.' } finally { $client.Close() } } } finally { $listener.Stop() }"
if errorlevel 1 pause
